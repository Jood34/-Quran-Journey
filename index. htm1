<style>
:root {
  --c1: #78909c;
  --c2: #9aadb5;
  --c4: #5f7580;

  --bg1: #eef2f3;
  --bg2: #eaf1f2;

  --card: rgba(255,255,255,.82);
  --text: #1f2d2a;
  --muted: #6b8079;

  --radius: 20px;
  --font: "Tajawal", sans-serif;
}

[data-dark="true"] {
  --bg1: #101719;
  --bg2: #0d1417;
  --card: rgba(26,35,39,.88);
  --text: #eef7f2;
  --muted: #9aada6;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font);
  color: var(--text);
  background: linear-gradient(135deg, var(--bg1), var(--bg2));
  transition: background .3s, color .3s;
}

button,
input,
select {
  font-family: inherit;
}

button {
  cursor: pointer;
}

.app {
  width: min(1100px, 100%);
  margin: auto;
  padding: 20px 16px 60px;
}

/* =========================
   HEADER
========================= */

header.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;

  background: var(--card);
  backdrop-filter: blur(10px);

  border-radius: var(--radius);
  padding: 12px 18px;
  margin-bottom: 22px;

  box-shadow: 0 6px 20px rgba(0,0,0,.06);
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 800;
  font-size: 1.1rem;
}

nav.tabs {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}

nav.tabs button {
  border: none;
  background: transparent;
  color: var(--muted);

  font-weight: 700;
  font-size: .86rem;

  padding: 8px 12px;
  border-radius: 14px;

  transition: .2s;
}

nav.tabs button:hover:not(.active) {
  background: rgba(0,0,0,.05);
}

nav.tabs button.active {
  color: white;
  background: linear-gradient(135deg,var(--c1),var(--c2));
}

/* =========================
   GENERAL
========================= */

.card {
  background: var(--card);
  backdrop-filter: blur(8px);

  border-radius: var(--radius);
  padding: 22px;
  margin-bottom: 18px;

  box-shadow: 0 6px 20px rgba(0,0,0,.05);
}

h1,
h2,
h3 {
  margin-top: 0;
}

h2 {
  font-size: 1.2rem;
  margin-bottom: 14px;
}

h3 {
  font-size: 1rem;
  margin-bottom: 10px;
}

.hint {
  color: var(--muted);
  font-size: .84rem;
  line-height: 1.8;
}

.btn {
  border: none;
  border-radius: 999px;

  padding: 12px 26px;

  font-size: .95rem;
  font-weight: 700;

  color: white;

  background: linear-gradient(135deg,var(--c1),var(--c2));

  box-shadow: 0 8px 18px rgba(120,144,156,.25);

  transition: .2s;
}

.btn:hover {
