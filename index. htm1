        الأجزاء المنجزة
      </div>

    </div>

    <div class="stat-box">

      <div class="num">
        ${total - done}
      </div>

      <div class="lbl">
        الأيام المتبقية
      </div>

    </div>

    <div class="stat-box">

      <div class="num">
        ${current}
      </div>

      <div class="lbl">
        المتتالية الحالية
      </div>

    </div>

    <div class="stat-box">

      <div class="num">
        ${streak}
      </div>

      <div class="lbl">
        أفضل متتالية 🔥
      </div>

    </div>

  </div>

  <div class="card">

    <h2>
      📈 الإنجاز الأسبوعي
    </h2>

    <div class="bars">

      ${weeks.map(week => {

        const height =
          (week / maxWeek * 100) || 2;

        return `
          <div
            class="bar"
            style="height:${height}%"
            title="${week} أيام"
          ></div>
        `;

      }).join("")}

    </div>

    <div class="bar-labels">

      ${weeks.map(
        (_,index) =>
          `<span>أسبوع ${index + 1}</span>`
      ).join("")}

    </div>

    <p class="hint">

      أفضل أسبوع:
      ${bestWeek} أيام مكتملة

    </p>

  </div>

  `;
}

/* =========================================================
   CALENDAR
========================================================= */

function viewCalendar() {

  if (!state.plan) {

    return `

      <div class="card">

        <h2>🗓️ التقويم</h2>

        <p class="hint">
          أنشئ خطة أولًا لعرض التقويم.
        </p>

      </div>

    `;
  }

  const base =
    new Date();

  base.setMonth(
    base.getMonth() +
    state.calMonthOffset
  );

  const year =
    base.getFullYear();

  const month =
    base.getMonth();

  const first =
    new Date(
      year,
      month,
      1
    );

  const daysInMonth =
    new Date(
      year,
      month + 1,
      0
    ).getDate();

  const startWeekday =
    first.getDay();

  const monthName =
    base.toLocaleDateString(
      "ar-SA",
      {
        month: "long",
        year: "numeric"
      }
    );

  const todayStr =
    new Date()
      .toISOString()
      .slice(0,10);

  const cells = [];

  for (
    let i = 0;
    i < startWeekday;
    i++
  ) {
    cells.push(null);
  }

  for (
    let day = 1;
    day <= daysInMonth;
    day++
  ) {
    cells.push(day);
  }

  const entryMap = {};

  state.entries.forEach(entry => {
    entryMap[entry.date] = entry;
  });

  const calendarHTML =
    cells.map(day => {

      if (!day) {

        return `
          <div
            class="cal-day"
            style="visibility:hidden"
          ></div>
        `;
      }

      const date =
        new Date(
          year,
          month,
          day
        );

      const dateStr =
        date.toISOString()
          .slice(0,10);

      const hijri =
        toHijri(
          date,
          state.plan.correction || 0
        );

      const entry =
        entryMap[dateStr];

      const isToday =
        dateStr === todayStr;

      const complete =
        entry && entry.done;

      return `

        <div
          class="
            cal-day
            ${isToday ? "today" : ""}
            ${complete ? "complete" : ""}
          "
        >

          <div class="g">
            ${day}
          </div>

          <div class="h">
            ${hijri.d}
          </div>

        </div>

      `;

    }).join("");

  const currentHijri =
    toHijri(
      base,
      state.plan.correction || 0
    );

  return `

  <div class="card">

    <div class="cal-head">

      <button
        class="icon-btn"
        onclick="
          state.calMonthOffset--;
          render()
        "
      >
        ‹
      </button>

      <div style="text-align:center">

        <h2 style="margin:0">
          ${monthName}
        </h2>

        <p
          class="hint"
          style="margin:2px 0 0"
        >
          ${HIJRI_MONTHS[currentHijri.m - 1]}
          ${currentHijri.y} هـ
        </p>

      </div>

      <button
        class="icon-btn"
        onclick="
          state.calMonthOffset++;
          render()
        "
      >
        ›
      </button>

    </div>

    <div class="cal-grid">

      ${HIJRI_WEEKDAYS.map(
        day => `
          <div
            style="
              text-align:center;
              color:var(--muted);
              font-size:.75rem;
              font-weight:700;
            "
          >
            ${day.substring(0,2)}
          </div>
        `
      ).join("")}

      ${calendarHTML}

    </div>

    <div class="legend">

      <span>
        <span
          class="dot"
          style="background:rgba(120,144,156,.6)"
        ></span>
        مكتمل
      </span>

      <span>
        <span
          class="dot"
          style="background:var(--c2)"
        ></span>
        اليوم
      </span>

      <span>
        <span
          class="dot"
          style="background:rgba(0,0,0,.15)"
        ></span>
        متبقي
      </span>

    </div>

  </div>

  `;
}

/* =========================================================
   ACHIEVEMENTS VIEW
========================================================= */

