  const settings =
    state.settings;

  return `

  <div class="card">

    <h3>
      🏆 مستويات الإنجاز
    </h3>

    <p class="hint">
      المستويات المتاحة في جدول المتابعة.
    </p>

    <div class="choice-group">

      ${LEVELS
        .filter(level => level.v)
        .map(
          level =>
            `<button
              type="button"
              disabled
            >
              ${level.l}
            </button>`
        )
        .join("")}

    </div>

  </div>

  <div class="card">

    <h3>
      🎨 المظهر
    </h3>

    <p class="hint">
      اختر لون لوحة الموقع.
    </p>

    <div class="swatches">

      ${Object.entries(
        PALETTES
      ).map(
        ([key,palette]) => `

          <div class="swatch-wrap">

            <div
              class="
                swatch
                ${
                  settings.palette === key
                    ? "active"
                    : ""
                }
              "
              data-p="${key}"
              style="
                background:${palette.hex}
              "
            ></div>

            ${palette.emoji}
            ${palette.name}

          </div>

        `
      ).join("")}

    </div>

    <div
      class="field"
      style="margin-top:20px"
    >

      <p class="hint">
        الوضع الليلي
      </p>

      <div class="toggle">

        <div
          class="
            switch
            ${settings.dark ? "on" : ""}
          "
          id="darkSwitch"
        >

          <div class="dot"></div>

        </div>

        <span>
          ${
            settings.dark
              ? "مفعّل"
              : "مغلق"
          }
        </span>

      </div>

    </div>

    <div
      class="field"
      style="margin-top:20px"
    >

      <p class="hint">
        الخط
      </p>

      <div class="font-opts">

        ${[
          "IBM Plex Sans Arabic",
          "Cairo",
          "Tajawal"
        ].map(font => `

          <button
            type="button"
            class="
              ft-btn
              ${
                settings.font === font
                  ? "active"
                  : ""
              }
            "
            data-f="${font}"
          >
            ${font}
          </button>

        `).join("")}

      </div>

    </div>

  </div>

  <div class="card danger-zone">

    <h3>
      ⚠️ منطقة الخطر
    </h3>

    <p class="hint">
      هذه الإجراءات لا يمكن التراجع عنها.
    </p>

    <div
      style="
        display:flex;
        gap:10px;
        flex-wrap:wrap;
      "
    >

      <button
        class="btn danger small"
        onclick="resetProgress()"
      >
        🗑️ حذف الإنجازات
      </button>

      <button
        class="btn danger small"
        onclick="deleteAllPlans()"
      >
        ↩️ البدء من جديد
      </button>

    </div>

  </div>

  `;
}

/* =========================================================
   SETTINGS EVENTS
========================================================= */

function bindSettingsEvents() {

  document
    .querySelectorAll(".swatch")
    .forEach(swatch => {

      swatch.addEventListener(
        "click",
        () => {

          state.settings.palette =
            swatch.dataset.p;

          saveSettings();

        }
      );

    });

  const darkSwitch =
    document.getElementById(
      "darkSwitch"
    );

  if (darkSwitch) {

    darkSwitch.addEventListener(
      "click",
      () => {

        state.settings.dark =
          !state.settings.dark;

        saveSettings();

      }
    );
  }

  document
    .querySelectorAll(".ft-btn")
    .forEach(button => {

      button.addEventListener(
        "click",
        () => {

          state.settings.font =
            button.dataset.f;

          saveSettings();

        }
      );

    });
}

/* =========================================================
   MAIN RENDER
========================================================= */

function render() {

  const app =
    document.getElementById("app");

  if (!app) return;

  const tabs = [

    {
      id: "home",
      label: "📘 الرئيسية"
    },

    {
      id: "calendar",
      label: "🗓️ التقويم"
    },

    {
      id: "stats",
      label: "📊 الإحصائيات"
    },

    {
      id: "achievements",
      label: "🏆 الإنجازات"
    },

    {
      id: "settings",
      label: "⚙️ الإعدادات"
    }

  ];

  const showNav =
    !!state.plan &&
    state.tab !== "setup";

  let body = "";

  if (state.tab === "setup") {

    body = viewSetup();

  } else if (!state.plan) {

    body = viewLanding();

  } else if (state.tab === "home") {

    body = viewHome();

  } else if (state.tab === "calendar") {

    body = viewCalendar();

  } else if (state.tab === "stats") {

    body = viewStats();

  } else if (state.tab === "achievements") {

    body = viewAchievements();

  } else if (state.tab === "settings") {

    body = viewSettings();

  }

  app.innerHTML = `

    ${
      showNav
        ? `

          <header class="nav">

            <div class="brand">
              📖
              <span>
                رحلتي مع القرآن
              </span>
            </div>

            <nav class="tabs">

              ${tabs.map(tab => `

                <button
                  class="
                    ${
                      state.tab === tab.id
                        ? "active"
                        : ""
                    }
                  "
                  data-tab="${tab.id}"
                >
                  ${tab.label}
                </button>

              `).join("")}

            </nav>

            ${
              state.tab === "home"
                ? `
                  <button
                    class="btn small secondary"
                    onclick="
                      state.tab='setup';
                      render()
                    "
                  >
                    + تعديل الخطة
                  </button>
                `
                : ""
            }

          </header>

        `
        : ""
    }

    ${body}

  `;

  document
    .querySelectorAll("[data-tab]")
    .forEach(button => {

      button.addEventListener(
        "click",
        () => {

          state.tab =
            button.dataset.tab;

          render();

        }
      );

    });

  if (
    state.tab === "setup"
  ) {
    bindSetupEvents();
  }

  if (
    state.tab === "home" &&
    state.plan
  ) {

    renderEntriesBody();

    document
      .querySelectorAll(
        "#filterGroup button"
      )
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            document
              .querySelectorAll(
                "#filterGroup button"
              )
              .forEach(item =>
                item.classList.remove(
                  "active"
                )
              );

            button.classList.add(
              "active"
            );

            currentFilter =
              button.dataset.f;

            renderEntriesBody();

          }
        );

      });

  }

  if (
    state.tab === "settings"
  ) {
    bindSettingsEvents();
  }
}

/* =========================================================
   SECURITY / HTML HELPERS
========================================================= */

function escapeHTML(value) {

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function escapeAttribute(value) {

  return escapeHTML(value);
}

/* =========================================================
   INIT
========================================================= */

function init() {

  const savedPlan =
    storeGet("plan");

  const savedEntries =
    storeGet("entries");

  const savedSettings =
    storeGet("settings");

  if (savedPlan) {
    state.plan = savedPlan;
  }

  if (Array.isArray(savedEntries)) {
    state.entries = savedEntries;
  }

  if (savedSettings) {

    state.settings =
      Object.assign(
        {},
        state.settings,
        savedSettings
      );
  }

  applySettings();

  render();
}

init();

</script>

