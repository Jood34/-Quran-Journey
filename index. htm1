.font-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.font-opts button {
  border: 1.5px solid rgba(0,0,0,.1);

  padding: 8px 16px;

  border-radius: 12px;

  background: transparent;

  color: var(--text);

  font-weight: 600;
}

.font-opts button.active {
  color: white;
  background: linear-gradient(135deg,var(--c1),var(--c2));
}

.danger-zone {
  border: 2px solid #e07a6f;

  border-radius: 16px;

  padding: 16px;

  background: rgba(224,122,111,.06);
