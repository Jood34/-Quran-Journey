========================================================= */

function updateEntry(index, patch) {

  if (!state.entries[index]) {
    return;
  }

  Object.assign(
    state.entries[index],
    patch
  );

  storeSet(
    "entries",
    state.entries
  );

  render();
}

function deleteEntry(index) {

  if (!confirm("هل تريد حذف هذا اليوم؟")) {
    return;
  }

  state.entries.splice(index,1);

  storeSet(
    "entries",
    state.entries
  );

  render();
}

function resetProgress() {

  if (
    !confirm(
      "هل أنت متأكد من إعادة ضبط جميع الإنجازات؟"
    )
  ) {
    return;
  }

  state.entries.forEach(entry => {

    entry.done = false;
    entry.level = "";
    entry.notes = "";

  });

  storeSet(
    "entries",
    state.entries
  );

  toast("تمت إعادة ضبط الإنجازات");

  render();
}

function deleteAllPlans() {

