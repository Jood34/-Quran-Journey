}

.swatch.active {
  border-color: var(--text);
}

.toggle {
  display: flex;
  align-items: center;
  gap: 10px;
}

.switch {
  position: relative;

  width: 46px;
  height: 26px;

  border-radius: 20px;

  background: rgba(0,0,0,.15);

  cursor: pointer;
}

.switch.on {
