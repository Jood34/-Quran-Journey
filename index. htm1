function bindSetupEvents() {

  const buttons =
    document.querySelectorAll(".tt-btn");

  let selectedType =
    state.plan?.trackType || "حفظ";

  buttons.forEach(button => {

    button.addEventListener(
      "click",
      () => {

        buttons.forEach(
          item =>
            item.classList.remove("active")
        );

        button.classList.add("active");

        selectedType =
          button.dataset.v;
      }
    );
  });

  const sDay =
    document.getElementById("s_day");

  const sMonth =
    document.getElementById("s_month");

  const sYear =
    document.getElementById("s_year");

  const eDay =
    document.getElementById("e_day");

  const eMonth =
    document.getElementById("e_month");

  const eYear =
    document.getElementById("e_year");

  const correction =
    document.getElementById("f_correction");

  const plan =
    state.plan || {};

  const startH =
    plan.startHijri || {
      d:1,
      m:1,
      y:hijriYearNow()
    };

  const endH =
    plan.endHijri || {
      d:1,
      m:2,
      y:hijriYearNow()
    };

  sDay.value =
    startH.d;

  sMonth.value =
    startH.m;

  eDay.value =
    endH.d;

  eMonth.value =
    endH.m;

  function updatePreview() {

    const corr =
      Number(correction.value) || 0;

    const startDate =
      hijriToDate(
        Number(sYear.value),
        Number(sMonth.value),
        Number(sDay.value),
        corr
      );

    const endDate =
      hijriToDate(
        Number(eYear.value),
        Number(eMonth.value),
        Number(eDay.value),
        corr
      );

    document.getElementById(
      "s_greg"
    ).textContent =
      "الموافق ميلاديًا: " +
      fmtGregorian(startDate);

    document.getElementById(
      "e_greg"
    ).textContent =
      "الموافق ميلاديًا: " +
      fmtGregorian(endDate);
  }

  [
    sDay,
    sMonth,
    sYear,
    eDay,
    eMonth,
    eYear,
    correction
  ].forEach(element => {

    element.addEventListener(
      "input",
      updatePreview
    );

    element.addEventListener(
      "change",
      updatePreview
    );

  });

  updatePreview();

  document
    .getElementById("saveSetupBtn")
    .addEventListener(
      "click",
      () => {

        const corr =
          Number(correction.value) || 0;

        const startHijri = {
          d: Number(sDay.value),
          m: Number(sMonth.value),
          y: Number(sYear.value)
        };

        const endHijri = {
          d: Number(eDay.value),
          m: Number(eMonth.value),
          y: Number(eYear.value)
        };

        const startDate =
          hijriToDate(
            startHijri.y,
            startHijri.m,
            startHijri.d,
            corr
          );

        const endDate =
          hijriToDate(
            endHijri.y,
            endHijri.m,
            endHijri.d,
            corr
          );

        if (endDate < startDate) {

          alert(
            "تاريخ النهاية يجب أن يكون بعد تاريخ البداية."
          );

          return;
        }

        const data = {

          title:
            document.getElementById(
              "f_title"
            ).value.trim() ||
            "خطة حفظ القرآن",

          startHijri,
          endHijri,

          startDateObj:
            startDate,

          endDateObj:
            endDate,

          correction: corr,

          startPointJuz:
            Number(
              document.getElementById(
                "f_startpoint"
              ).value
            ) || 1,

          unit:
            document.getElementById(
              "f_unit"
            ).value,

          dailyAmount:
            Number(
              document.getElementById(
                "f_amount"
              ).value
            ) || 1,

          trackType:
            selectedType

        };

        createPlan(data);

      }
    );
}

