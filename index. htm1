}

.ach .t {
  font-weight: 700;
  margin: 6px 0 2px;
}

.ach .d {
  color: var(--muted);
  font-size: .75rem;

  margin-bottom: 8px;
}

.progress {
  height: 6px;

  background: rgba(0,0,0,.08);

  border-radius: 6px;

  overflow: hidden;
}

.progress > div {
  height: 100%;

