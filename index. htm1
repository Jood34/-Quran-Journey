/* =========================================================
   CREATE PLAN
========================================================= */

function createPlan(data) {

  state.plan = data;
  state.entries = [];

  const start =
    new Date(data.startDateObj);

  const end =
    new Date(data.endDateObj);

  const totalDays =
    Math.max(
      1,
      Math.round(
        (end - start) /
        86400000
      ) + 1
    );

  let amount = 1;

  for (
    let i = 0;
    i < totalDays;
    i++
  ) {

    const date =
      new Date(
        start.getTime() +
        i * 86400000
      );

    const hijri =
      toHijri(
        date,
        data.correction
      );

    state.entries.push({

      date:
        date.toISOString().slice(0,10),

      hijri:
        fmtHijri(hijri),

      partLabel:
        `${data.unit} ${
          Number.isInteger(amount)
            ? amount
            : amount.toFixed(1)
        }`,

      level: "",
      notes: "",
      done: false

    });

    amount +=
      Number(data.dailyAmount) || 1;
  }

  storeSet(
    "plan",
    state.plan
  );

  storeSet(
    "entries",
    state.entries
  );

  state.tab = "home";

  toast("🌿 تم إنشاء رحلة الحفظ");

  render();
}

