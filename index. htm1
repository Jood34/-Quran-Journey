  },
  {
    v: "لم يكتمل",
    l: "🔴 لم يكتمل"
  }
];

const PALETTES = {
  "dusty-blue": {
    name: "أزرق رمادي",
    emoji: "🩵",
    hex: "#78909C"
  },

  "pink-earthy": {
    name: "وردي ترابي",
    emoji: "🩷",
    hex: "#C49A9A"
  },

  "tiffany": {
    name: "تيفاني",
    emoji: "🩵",
    hex: "#6FC8C0"
  },

  "purple-calm": {
    name: "بنفسجي هادئ",
    emoji: "💜",
    hex: "#9B8FB8"
  }
};

const state = {
  plan: null,
  entries: [],
  settings: {
    palette: "dusty-blue",
    dark: false,
    font: "Tajawal"
  },
  tab: "home",
  calMonthOffset: 0
};

let currentFilter = "all";

/* =========================================================
   STORAGE
========================================================= */

function storeGet(key) {
  try {
    const value = localStorage.getItem(key);

    if (!value) {
      return null;
    }

    return JSON.parse(value);

  } catch (error) {
    console.error(error);
    return null;
  }
}

function storeSet(key, value) {
  try {
    localStorage.setItem(
      key,
      JSON.stringify(value)
    );

  } catch (error) {
    console.error(error);
  }
}

/* =========================================================
   DATE FUNCTIONS
========================================================= */

function gregorianToJD(y, m, d) {

  const a = Math.floor((14 - m) / 12);

  const yy = y + 4800 - a;

  const mm = m + 12 * a - 3;

  return (
    d +
    Math.floor((153 * mm + 2) / 5) +
    365 * yy +
    Math.floor(yy / 4) -
    Math.floor(yy / 100) +
    Math.floor(yy / 400) -
    32045
  );
}

function jdToHijri(jd) {

  jd = Math.floor(jd) + 0.5;

  const iy = Math.floor(
    (30 * (jd - 1948440) + 10646) / 10631
  );

  const jd1 = Math.floor(
    10631 * iy / 30 +
    1948440 -
    385
  );

  const days = jd - jd1;

  const monthLengths = [
    30,29,30,29,30,29,
    30,29,30,29,30,29
  ];

  let month = 0;
  let daysBefore = 0;

  for (let i = 0; i < 12; i++) {

    if (days <= daysBefore + monthLengths[i]) {
      month = i;
      break;
    }

    daysBefore += monthLengths[i];
  }

  let day = Math.round(days - daysBefore);

  if (day < 1) {
    day = 1;
  }

  if (day > 30) {
    day = 30;
  }

  return {
    y: iy,
    m: month + 1,
    d: day
  };
}

function hijriToJD(y, m, d) {

  return (
    Math.floor((11 * y + 3) / 30) +
    354 * y +
    30 * m -
    Math.floor((m - 1) / 2) +
    d +
    1948440 -
    385
  );
}

function jdToGregorian(jd) {

  jd = Math.floor(jd);

  const a = jd + 32044;

  const b = Math.floor(
    (4 * a + 3) / 146097
  );

  const c =
    a -
    Math.floor(146097 * b / 4);

  const d4 = Math.floor(
    (4 * c + 3) / 1461
  );

  const e =
    c -
    Math.floor(1461 * d4 / 4);

  const m4 = Math.floor(
    (5 * e + 2) / 153
  );

  const day =
    e -
    Math.floor((153 * m4 + 2) / 5) +
    1;

  const month =
    m4 +
    3 -
    12 * Math.floor(m4 / 10);

  const year =
    100 * b +
    d4 -
    4800 +
    Math.floor(m4 / 10);

  return {
    y: year,
    m: month,
    d: day
  };
}

function toHijri(date, correctionDays = 0) {

  const jd =
    gregorianToJD(
      date.getFullYear(),
      date.getMonth() + 1,
      date.getDate()
    ) + correctionDays;

  return jdToHijri(jd);
}

function hijriToDate(
  y,
  m,
  d,
  correctionDays = 0
) {

  const jd =
    hijriToJD(y,m,d) -
    correctionDays;

  const g = jdToGregorian(jd);

  return new Date(
    g.y,
    g.m - 1,
    g.d
  );
}

function fmtHijri(h) {

  return `${h.d} ${HIJRI_MONTHS[h.m - 1]} ${h.y} هـ`;
}

function fmtGregorian(date) {

  return date.toLocaleDateString(
    "ar-SA",
    {
      year: "numeric",
      month: "long",
      day: "numeric"
    }
  );
}

function hijriYearNow() {

  return toHijri(new Date()).y;
}

/* =========================================================
   COLORS
========================================================= */

function lighten(hex, amount) {

  const clean = hex.replace("#","");

  const r = Math.min(
    255,
    parseInt(clean.substring(0,2),16) + amount
  );

  const g = Math.min(
    255,
    parseInt(clean.substring(2,4),16) + amount
  );

  const b = Math.min(
    255,
    parseInt(clean.substring(4,6),16) + amount
  );

  return "#" +
    [r,g,b]
      .map(
        v => v
          .toString(16)
          .padStart(2,"0")
      )
      .join("");
}

function darken(hex, amount) {

  return lighten(hex, -amount);
}

/* =========================================================
   STATS
========================================================= */

function doneCount() {

  return state.entries.filter(
    entry => entry.done
  ).length;
}

function bestStreak() {

  let best = 0;
  let current = 0;

  for (const entry of state.entries) {

    if (entry.done) {

      current++;

      best = Math.max(
        best,
        current
      );

    } else {

      current = 0;
    }
  }

  return best;
}

function currentStreak() {

  let current = 0;

  for (
    let i = state.entries.length - 1;
    i >= 0;
    i--
  ) {

    if (state.entries[i].done) {
      current++;
    } else {
      break;
    }
  }

  return current;
}

function cumulativeJuz() {

  if (!state.plan) {
    return 0;
  }

  let factor = 0;

  if (state.plan.unit === "جزء") {
    factor = 1;
  }

  if (state.plan.unit === "صفحة") {
    factor = 1 / 20;
  }

  if (state.plan.unit === "وجه") {
    factor = 1 / 40;
  }

  return (
    doneCount() *
    Number(state.plan.dailyAmount || 0) *
    factor
  );
}

function cumulativeHizb() {

  return cumulativeJuz() * 2;
}

