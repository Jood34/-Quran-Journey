/* =========================
   TOAST
========================= */

.toast {
  position: fixed;

  bottom: 20px;
  left: 50%;

  transform: translateX(-50%);

  background: #1f2d2a;
  color: white;

  padding: 10px 22px;

  border-radius: 999px;

  font-size: .85rem;

  opacity: 0;

  pointer-events: none;

  transition: .3s;

  z-index: 1000;
}

.toast.show {
  opacity: 1;
  bottom: 32px;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 700px) {

  .grid2 {
